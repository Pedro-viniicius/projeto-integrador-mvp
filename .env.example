# Credenciais públicas do Supabase (projeto do MVP).
# Copie este arquivo para `.env` e preencha com os valores do seu projeto Supabase.
# Painel: https://supabase.com/dashboard  ->  Project Settings  ->  API
#
# ATENÇÃO: nunca coloque a chave `service_role` aqui nem em qualquer arquivo do app mobile.
# O aplicativo usa apenas a chave `anon`, protegida por Row Level Security no banco.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Modo demonstração (opcional).
# "true"  -> o app roda 100% offline com dados de exemplo (útil para apresentação em sala).
# "false" -> o app usa o Supabase configurado acima.
# Se as variáveis acima estiverem vazias, o app entra em modo demonstração automaticamente.
EXPO_PUBLIC_DEMO_MODE=
